---
import { Card } from "@astrojs/starlight/components";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import ReleaseCard from "./ReleaseCard.astro";

interface Props {
  locale: "en" | "uk";
}

const { locale } = Astro.props;
const isUk = locale === "uk";

const copy = isUk
  ? {
      title: "Завантажити Apis JAR - Збірки ядра Paper",
      description:
        "Актуальні та архівні збірки серверного ядра Apis (форк Paper для Minecraft), історія змін і пряме завантаження JAR.",
      heading: "Усі збірки",
      loadingTitle: "Завантаження...",
      loadingBody: "Отримання списку релізів...",
    }
  : {
      title: "Download Apis JAR - Paper Fork Server Builds",
      description:
        "Download the latest and archived Apis Minecraft server JAR builds (Paper fork for lobbies and minigames), with changelogs and release history.",
      heading: "All Releases",
      loadingTitle: "Loading...",
      loadingBody: "Fetching release list...",
    };
---

<StarlightPage
  frontmatter={{
    title: copy.title,
    description: copy.description,
  }}
  hasSidebar={true}
  headings={[{ depth: 2, slug: "releases", text: copy.heading }]}
>
  <Card title={copy.loadingTitle}>{copy.loadingBody}</Card>

  <ReleaseCard />
</StarlightPage>

<script>
  import "../scripts/downloads/initDownloads";
</script>
